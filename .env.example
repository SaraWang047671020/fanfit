QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
OPENAI_API_KEY=
OPENAI_MODEL=

# Supabase (sign-in and accounts). Local: `npx supabase start` prints both values; cloud: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Kill switch: "true" turns off every route that calls Qloo + OpenAI web search (FanFit runs, team checks, activations).
LIVE_RUNS_DISABLED=

# Server-only Supabase secret key, for the shared Qloo response cache (qloo_cache). Never prefix with NEXT_PUBLIC_.
# Local: `npx supabase status` (SECRET_KEY); cloud: Project Settings → API Keys → Secret keys. Leave empty to disable.
SUPABASE_SECRET_KEY=
